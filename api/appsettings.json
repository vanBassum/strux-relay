{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Relay": {
    "Database": {
      "Provider": "sqlite",
      "ConnectionString": "Data Source=relay.sqlite"
    },
    "Telemetry": {
      "QueueCapacity": 10000,
      "BatchSize": 500,
      "MaxBatchAge": "00:00:05",
      "Influx": {
        "Url": "",
        "Token": "",
        "Org": "",
        "Bucket": "",
        "Timeout": "00:00:10"
      }
    },
    "Cache": {
      "MaxBytes": 33554432,
      "WarmOnConnect": true
    }
  }
}
